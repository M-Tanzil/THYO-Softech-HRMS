generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee?

  userRoles         UserRole[]
  assignedUserRoles UserRole[]     @relation("RoleAssignedBy")
  refreshTokens     RefreshToken[]

  employeeBranchTransfers EmployeeBranchHistory[] @relation("EmployeeBranchTransferredBy")

  attendanceAdjustmentsRequested AttendanceAdjustment[] @relation("AttendanceAdjustmentRequestedBy")

  attendanceAdjustmentsApproved AttendanceAdjustment[] @relation("AttendanceAdjustmentApprovedBy")

  overtimeRecordsApproved OvertimeRecord[] @relation("OvertimeApprovedBy")

  leaveRequestsApproved LeaveRequest[] @relation("LeaveRequestApprover")

  leaveApprovals LeaveApproval[] @relation("LeaveApprovalApprover")

  taskAssignmentsAssigned TaskAssignment[] @relation("TaskAssignedBy")

  taskAttachments TaskAttachment[]

  createdTasks Task[] @relation("TaskCreatedBy")

  jobRequisitions JobRequisition[] @relation("JobRequisitionRequestedBy")

  interviews Interview[] @relation("InterviewInterviewer")

  performanceReviews PerformanceReview[] @relation("PerformanceReviewer")

  performanceFeedback PerformanceFeedback[] @relation("PerformanceFeedbackReviewer")

  wfhRequestsApproved WfhRequest[] @relation("WfhRequestApprover")

  uploadedDocuments EmployeeDocument[] @relation("DocumentUploadedBy")

  announcements Announcement[] @relation("AnnouncementCreatedBy")

  notifications Notification[]

  notificationPreferences NotificationPreference?

  auditLogs AuditLog[]

  walletTransactions WalletTransaction[] @relation("WalletTransactionCreatedBy")

  fundAllocations FundAllocation[] @relation("FundAllocatedBy")

  expenseRequestsApproved ExpenseRequest[] @relation("ExpenseApprover")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedByUser User? @relation("RoleAssignedBy", fields: [assignedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  legalName String?  @map("legal_name")
  logo      String?
  email     String?
  phone     String?
  address   String?
  status    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches     Branch[]
  departments  Department[]
  designations Designation[]
  shifts       Shift[]
  employees    Employee[]

  attendancePolicies AttendancePolicy[]
  leaveTypes         LeaveType[]
  salaryComponents   SalaryComponent[]

  projects          Project[]
  expenseCategories ExpenseCategory[]
  jobRequisitions   JobRequisition[]
  performanceCycles PerformanceCycle[]

  wallets       Wallet[]
  holidays      Holiday[]
  announcements Announcement[]
  auditLogs     AuditLog[]
  documentTypes DocumentType[]
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  code      String   @unique
  logo      String?
  address   String?
  city      String?
  state     String?
  country   String?
  phone     String?
  email     String?
  status    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departments Department[]
  shifts      Shift[]
  employees   Employee[]

  employeeBranchHistory EmployeeBranchHistory[]

  attendancePolicies AttendancePolicy[]
  projects           Project[]

  wallets         Wallet[]
  fundAllocations FundAllocation[]

  holidays HolidayBranch[]

  auditLogs AuditLog[]

  jobRequisitions JobRequisition[]
  tasks           Task[]
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  name        String
  code        String?
  description String?
  status      String?
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  employees Employee[]
  projects  Project[]

  jobRequisitions JobRequisition[]
}

model Designation {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  name        String
  description String?
  level       Int?
  status      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employees       Employee[]
  jobRequisitions JobRequisition[]
}

model Shift {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  name         String
  startTime    DateTime @map("start_time") @db.Time(0)
  endTime      DateTime @map("end_time") @db.Time(0)
  graceMinutes Int?     @map("grace_minutes")
  regularHours Decimal? @map("regular_hours") @db.Decimal(5, 2)
  status       String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  attendance Attendance[]
}

model Employee {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  departmentId      String    @map("department_id") @db.Uuid
  designationId     String    @map("designation_id") @db.Uuid
  managerId         String?   @map("manager_id") @db.Uuid
  employeeCode      String    @unique @map("employee_code")
  firstName         String    @map("first_name")
  lastName          String?   @map("last_name")
  profileImage      String?   @map("profile_image")
  phone             String?
  email             String?
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  dateOfJoining     DateTime? @map("date_of_joining") @db.Date
  employmentStatus  String?   @map("employment_status")
  documentsVerified Boolean   @default(false) @map("documents_verified")
  address           String?
  emergencyContact  String?   @map("emergency_contact")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  company Company @relation(fields: [companyId], references: [id])

  branch Branch @relation(fields: [branchId], references: [id])

  department Department @relation(fields: [departmentId], references: [id])

  designation Designation @relation(fields: [designationId], references: [id])

  manager Employee? @relation("EmployeeManager", fields: [managerId], references: [id])

  subordinates Employee[] @relation("EmployeeManager")

  branchHistory EmployeeBranchHistory[] @relation("EmployeeBranchHistoryEmployee")

  attendance Attendance[]

  attendanceLogs AttendanceLog[]

  attendanceAdjustments AttendanceAdjustment[]

  overtimeRecords OvertimeRecord[]

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  salaryStructures  SalaryStructure[]
  payroll           Payroll[]
  payslips          Payslip[]
  payrollAdditions  PayrollAddition[]
  payrollDeductions PayrollDeduction[]

  taskAssignments TaskAssignment[]
  taskUpdates     TaskUpdate[]
  taskComments    TaskComment[]
  taskTimeLogs    TaskTimeLog[]

  wallet Wallet?

  fundAllocations FundAllocation[]

  expenseRequests ExpenseRequest[]

  performanceGoals    PerformanceGoal[]
  performanceReviews  PerformanceReview[]
  performanceFeedback PerformanceFeedback[]

  wfhRequests WfhRequest[]

  documents EmployeeDocument[]

  projectsManaged Project[] @relation("ProjectManager")
}

model EmployeeBranchHistory {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  transferReason String?   @map("transfer_reason")
  transferredBy  String?   @map("transferred_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  employee Employee @relation("EmployeeBranchHistoryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id])

  transferredByUser User? @relation("EmployeeBranchTransferredBy", fields: [transferredBy], references: [id])

  @@map("employee_branch_history")
}

model Attendance {
  id                String   @id @default(uuid()) @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  shiftId           String   @map("shift_id") @db.Uuid
  attendanceDate    DateTime @map("attendance_date") @db.Date
  status            String
  workingHours      Decimal? @map("working_hours") @db.Decimal(5, 2)
  regularHours      Decimal? @map("regular_hours") @db.Decimal(5, 2)
  overtimeHours     Decimal? @map("overtime_hours") @db.Decimal(5, 2)
  overtimeStatus    String?  @map("overtime_status")
  overtimeAlertSent Boolean  @default(false) @map("overtime_alert_sent")
  remarks           String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  shift Shift @relation(fields: [shiftId], references: [id])

  logs AttendanceLog[]

  adjustments AttendanceAdjustment[]

  overtimeRecords OvertimeRecord[]

  @@map("attendance")
}

model AttendanceLog {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  attendanceId String   @map("attendance_id") @db.Uuid
  eventType    String   @map("event_type")
  eventTime    DateTime @map("event_time")
  location     String?
  ipAddress    String?  @map("ip_address")
  deviceInfo   String?  @map("device_info")
  createdAt    DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@map("attendance_logs")
}

model AttendanceAdjustment {
  id           String    @id @default(uuid()) @db.Uuid
  attendanceId String    @map("attendance_id") @db.Uuid
  requestedBy  String    @map("requested_by") @db.Uuid
  approvedBy   String?   @map("approved_by") @db.Uuid
  oldCheckIn   DateTime? @map("old_check_in")
  oldCheckOut  DateTime? @map("old_check_out")
  newCheckIn   DateTime? @map("new_check_in")
  newCheckOut  DateTime? @map("new_check_out")
  reason       String?
  status       String
  createdAt    DateTime  @default(now()) @map("created_at")

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  requestedByUser User @relation("AttendanceAdjustmentRequestedBy", fields: [requestedBy], references: [id])

  approvedByUser User?     @relation("AttendanceAdjustmentApprovedBy", fields: [approvedBy], references: [id])
  employee       Employee? @relation(fields: [employeeId], references: [id])
  employeeId     String?   @db.Uuid

  @@map("attendance_adjustments")
}

model AttendancePolicy {
  id                     String  @id @default(uuid()) @db.Uuid
  companyId              String  @map("company_id") @db.Uuid
  branchId               String  @map("branch_id") @db.Uuid
  lateThresholdMinutes   Int     @map("late_threshold_minutes")
  halfDayHours           Decimal @map("half_day_hours") @db.Decimal(5, 2)
  fullDayHours           Decimal @map("full_day_hours") @db.Decimal(5, 2)
  overtimeEnabled        Boolean @map("overtime_enabled")
  overtimeThresholdHours Decimal @map("overtime_threshold_hours") @db.Decimal(5, 2)
  status                 String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("attendance_policies")
}

model OvertimeRecord {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  attendanceId  String    @map("attendance_id") @db.Uuid
  overtimeDate  DateTime  @map("overtime_date") @db.Date
  regularHours  Decimal   @map("regular_hours") @db.Decimal(5, 2)
  actualHours   Decimal   @map("actual_hours") @db.Decimal(5, 2)
  overtimeHours Decimal   @map("overtime_hours") @db.Decimal(5, 2)
  status        String
  approvedBy    String?   @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  approvedByUser User? @relation("OvertimeApprovedBy", fields: [approvedBy], references: [id])

  @@map("overtime_records")
}

model LeaveType {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  name        String
  description String?
  annualLimit Decimal @map("annual_limit") @db.Decimal(5, 2)
  isPaid      Boolean @map("is_paid")
  status      String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id             String  @id @default(uuid()) @db.Uuid
  employeeId     String  @map("employee_id") @db.Uuid
  leaveTypeId    String  @map("leave_type_id") @db.Uuid
  year           Int
  allocated      Decimal @db.Decimal(5, 2)
  used           Decimal @db.Decimal(5, 2)
  pending        Decimal @db.Decimal(5, 2)
  remaining      Decimal @db.Decimal(5, 2)
  carriedForward Decimal @map("carried_forward") @db.Decimal(5, 2)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@map("leave_balances")
}

model LeaveRequest {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  leaveTypeId String    @map("leave_type_id") @db.Uuid
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  reason      String?
  status      String
  approverId  String?   @map("approver_id") @db.Uuid
  approvedAt  DateTime? @map("approved_at")
  rejectedAt  DateTime? @map("rejected_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  approver User? @relation("LeaveRequestApprover", fields: [approverId], references: [id])

  approvals LeaveApproval[]

  @@map("leave_requests")
}

model LeaveApproval {
  id             String   @id @default(uuid()) @db.Uuid
  leaveRequestId String   @map("leave_request_id") @db.Uuid
  approverId     String   @map("approver_id") @db.Uuid
  action         String
  comments       String?
  actionAt       DateTime @map("action_at")

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  approver User @relation("LeaveApprovalApprover", fields: [approverId], references: [id])

  @@map("leave_approvals")
}

model SalaryStructure {
  id                 String    @id @default(uuid()) @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  basicSalary        Decimal   @map("basic_salary") @db.Decimal(12, 2)
  housingAllowance   Decimal   @map("housing_allowance") @db.Decimal(12, 2)
  transportAllowance Decimal   @map("transport_allowance") @db.Decimal(12, 2)
  otherAllowance     Decimal   @map("other_allowance") @db.Decimal(12, 2)
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  status             String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

model SalaryComponent {
  id              String  @id @default(uuid()) @db.Uuid
  companyId       String  @map("company_id") @db.Uuid
  name            String
  componentType   String  @map("component_type")
  calculationType String  @map("calculation_type")
  defaultValue    Decimal @map("default_value") @db.Decimal(12, 2)
  status          String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("salary_components")
}

model Payroll {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  month           Int
  year            Int
  basicSalary     Decimal   @map("basic_salary") @db.Decimal(12, 2)
  grossSalary     Decimal   @map("gross_salary") @db.Decimal(12, 2)
  totalAdditions  Decimal   @map("total_additions") @db.Decimal(12, 2)
  totalDeductions Decimal   @map("total_deductions") @db.Decimal(12, 2)
  taxDeduction    Decimal   @map("tax_deduction") @db.Decimal(12, 2)
  netSalary       Decimal   @map("net_salary") @db.Decimal(12, 2)
  status          String
  processedAt     DateTime? @map("processed_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  payslips Payslip[]

  additions PayrollAddition[]

  deductions PayrollDeduction[]

  @@map("payroll")
}

model Payslip {
  id          String   @id @default(uuid()) @db.Uuid
  payrollId   String   @map("payroll_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  filePath    String   @map("file_path")
  generatedAt DateTime @default(now()) @map("generated_at")

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("payslips")
}

model PayrollAddition {
  id          String   @id @default(uuid()) @db.Uuid
  payrollId   String   @map("payroll_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  name        String
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("payroll_additions")
}

model PayrollDeduction {
  id          String   @id @default(uuid()) @db.Uuid
  payrollId   String   @map("payroll_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  name        String
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("payroll_deductions")
}

model Project {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  managerId    String    @map("manager_id") @db.Uuid
  name         String
  description  String?
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  status       String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  manager Employee @relation("ProjectManager", fields: [managerId], references: [id])

  tasks Task[]

  @@map("projects")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  createdBy   String    @map("created_by") @db.Uuid
  title       String
  description String?
  priority    String
  status      String
  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id])

  createdByUser User @relation("TaskCreatedBy", fields: [createdBy], references: [id])

  assignments TaskAssignment[]

  updates TaskUpdate[]

  comments TaskComment[]

  timeLogs TaskTimeLog[]

  attachments TaskAttachment[]

  @@map("tasks")
}

model TaskAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  assignedBy String   @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  status     String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  assignedByUser User @relation("TaskAssignedBy", fields: [assignedBy], references: [id])

  @@map("task_assignments")
}

model TaskUpdate {
  id                 String   @id @default(uuid()) @db.Uuid
  taskId             String   @map("task_id") @db.Uuid
  employeeId         String   @map("employee_id") @db.Uuid
  progressPercentage Int      @map("progress_percentage")
  status             String
  updateText         String?  @map("update_text")
  blocker            String?
  createdAt          DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("task_updates")
}

model TaskComment {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  comment    String
  createdAt  DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model TaskTimeLog {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
