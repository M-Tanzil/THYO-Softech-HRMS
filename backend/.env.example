# Application Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection (Prisma ORM with Supabase Transaction Pooling)
# Port 6543 (Transaction Pooler) for runtime Prisma queries:
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30&pool_timeout=30"
# Port 5432 (Direct / Session Pooler) for Prisma migrations and CLI:
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?connect_timeout=30"

# Central HRMS JWT Secret & Authentication Bridge
JWT_SECRET="your_secure_jwt_secret_key_from_central_hrms_auth"
JWT_EXPIRES_IN="7d"

# Standalone Dev Adapter Flag (true for local development, false in production)
ENABLE_DEV_AUTH=true
